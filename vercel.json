{
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npx vite build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo done",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agriverseai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
